meta {
  name: 04 - Criar endereco da loja
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/stores/{{storeId}}/addresses
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "street": "Rua 44",

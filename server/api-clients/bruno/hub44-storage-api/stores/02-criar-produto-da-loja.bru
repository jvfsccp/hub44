meta {
  name: 05 - Criar produto
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/stores/{{storeId}}/products
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "categoryId": "{{categoryId}}",
    "name": "Cafe especial 250g",
    "description": "Graos selecionados, torra media",
    "priceInCents": 3990,
    "stock": 20
  }
}

docs {
  Copie product.id da resposta e cole na variavel productId.
}

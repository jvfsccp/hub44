meta {
  name: 03 - Criar loja
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/stores
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Cafeteria Centro",
    "description": "Cafeteria com produtos artesanais",
    "cnpj": "12345678000190",
    "phone": "62999999999"
  }
}

docs {
  Copie store.id da resposta e cole na variavel storeId.
}

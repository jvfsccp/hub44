meta {
  name: 06 - Upload imagem do produto
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/stores/{{storeId}}/products/{{productId}}/image
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:multipart-form {
  image: @file(./produto.jpg)
}

docs {
  Antes de enviar, selecione uma imagem real no campo image.
}

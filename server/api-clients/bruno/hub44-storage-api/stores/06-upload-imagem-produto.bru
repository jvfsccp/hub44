meta {
  name: 08 - Upload imagem do produto
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/stores/{{storeId}}/products/{{productId}}/image
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:multipart-form {
  image: @file(./produto.jpg)
}

vars:pre-request {
  baseUrl: http://localhost:3333
}

docs {
  Antes de enviar, selecione uma imagem real no campo image.
}
